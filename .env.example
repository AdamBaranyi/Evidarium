# Kopieren nach .env und ausfüllen. Nur Platzhalter, nie echte Werte.
# Bei fehlendem Wert bricht die Anwendung beim Start ab — ein Vorgabewert
# würde aus einem Konfigurationsfehler eine stille Fehlverbindung machen.

# Migrationen laufen als Eigentümer, die Anwendung als eingeschränkte Rolle.
DATABASE_URL=postgres://evidarium_app:entwicklung-nur-lokal@127.0.0.1:5450/evidarium
DATABASE_URL_OWNER=postgres://evidarium_owner:entwicklung-nur-lokal@127.0.0.1:5450/evidarium
TEST_DATABASE_URL=postgres://evidarium_owner:test-nur-lokal@127.0.0.1:5451/evidarium_test

# Mindestens 32 Byte. Erzeugen mit: openssl rand -base64 48
SESSION_SECRET=

# Vollständige Herkunft inklusive Schema, für Origin-Prüfung und Cookies.
# Port 3100 statt 3000: Auf diesem Rechner belegen andere Projekte die 3000.
APP_ORIGIN=http://localhost:3100

# Wohin die hochgeladenen Dateien geschrieben werden. Der Pfad wird
# serverseitig aus Nutzer- und Dokument-ID gebildet, nie aus dem Dateinamen.
STORAGE_PATH=./storage

# Hinter einem Reverse Proxy auf true: dann zählt das linkeste X-Forwarded-For.
TRUST_PROXY=false
