{
  "name": "evidarium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-length": "node scripts/check-file-length.mjs",
    "check:font-floor": "node scripts/check-font-floor.mjs",
    "verify": "bun run format:check && bun run check:file-length && bun run check:font-floor && bun run lint && bun run typecheck",
    "test": "vitest run",
    "test:lokal": "bun --env-file=.env vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "bun scripts/migrieren.ts",
    "konto:anlegen": "bun --env-file=.env scripts/konto-anlegen.ts",
    "worker": "bun --env-file=.env src/worker/index.ts",
    "dev:all": "bun run worker & bun run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@huggingface/transformers": "4.2.0",
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "1.8.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "adm-zip": "0.6.1"
  }
}
