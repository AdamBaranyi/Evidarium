{
  "name": "evidarium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-length": "node scripts/check-file-length.mjs",
    "check:font-floor": "node scripts/check-font-floor.mjs",
    "verify": "bun run format:check && bun run check:file-length && bun run check:font-floor && bun run lint && bun run typecheck",
    "test": "vitest run",
    "test:lokal": "bun --env-file=.env vitest run",
    "test:e2e": "playwright test",
    "test:screenreader": "playwright test -c playwright.screenreader.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "bun scripts/migrieren.ts",
    "konto:anlegen": "bun --env-file=.env scripts/konto-anlegen.ts",
    "worker": "bun --env-file=.env src/worker/index.ts",
    "dev:all": "bun run worker & bun run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@huggingface/transformers": "4.3.1",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unpdf": "1.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@guidepup/guidepup": "0.36.3",
    "@guidepup/playwright": "0.20.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
